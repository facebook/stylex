{
  "name": "@stylexjs/devtools-extension",
  "version": "0.19.1",
  "private": true,
  "description": "Chrome, Firefox, and Safari DevTools extension for debugging StyleX.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/stylex.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "rollup -c --watch",
    "build": "rollup -c",
    "test": "jest --config jest.config.js --runInBand",
    "verify:build": "node scripts/verify-build.mjs",
    "web-ext:lint": "node scripts/lint-firefox.mjs",
    "web-ext:build": "yarn build && node scripts/package.mjs"
  },
  "files": [
    "dist/chrome/**",
    "dist/firefox/**",
    "dist/safari/**"
  ],
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "postcss-selector-parser": "7.1.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-flow-strip-types": "^8.0.1",
    "@stylexjs/unplugin": "0.19.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "jszip": "3.10.2",
    "rollup": "^4.63.6",
    "web-ext": "10.7.0"
  }
}
