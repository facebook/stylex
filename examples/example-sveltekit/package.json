  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@stylexjs/eslint-plugin": "0.19.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.3.5",
    "@stylexjs/unplugin": "0.19.1"
  }
